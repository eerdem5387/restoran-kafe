# Environment — Neon + Admin
#
# Local development works WITHOUT these database URLs (uses data/*.json).
# For Vercel / Neon production, set both DATABASE_URL and DIRECT_URL.

# Neon pooled connection (has `-pooler` in hostname) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Neon direct connection (no `-pooler`) — used by Prisma CLI (migrate, db push, seed)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Admin panel — use strong unique values in production (32+ char secret, 12+ char password)
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Vercel Blob
# On Vercel, connecting a Blob store adds BLOB_STORE_ID (+ OIDC). That is enough in production.
# For local uploads, either run `vercel env pull` or add a read-write token from the Blob store.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
